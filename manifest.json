{
  "manifest_version": 3,
  "name": "ClearCast Noise Filter",
  "version": "1.1.0",
  "description": "Reduce background noise from video and audio playing in the active Chrome tab.",
  "permissions": ["tabCapture", "activeTab", "offscreen", "storage"],
  "action": {
    "default_title": "ClearCast Noise Filter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "minimum_chrome_version": "116"
}
